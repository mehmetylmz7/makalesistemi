@model List<makalesistemi.Models.Sohbet>
@{
    ViewData["Title"] = "Admin Sohbet Paneli";
    var makaleler = ViewBag.Makaleler as List<makalesistemi.Models.Makale>;
    int? seciliMakaleId = ViewBag.SeciliMakaleId as int?;
}

<div class="container mt-4">
    <div class="card shadow">
        <div class="card-header bg-primary text-white">
            <h2 class="mb-0"><i class="fas fa-comments"></i> Admin Sohbet Paneli</h2>
        </div>
        <div class="card-body">
            <!-- Makale Seçimi -->
            <form method="get" asp-action="Sohbet" class="mb-4">
                <div class="form-group">
                    <label class="form-label">Makale Seç:</label>
                    <select name="makaleId" class="form-select" onchange="this.form.submit()">
                        <option value="">Makale Seçiniz...</option>
                        @foreach (var makale in makaleler)
                        {
                            <option value="@makale.Id" selected="@(makale.Id == seciliMakaleId)">
                                @($"Makale {makale.Id} - {makale.Yazar.Eposta}")
                            </option>
                        }
                    </select>
                </div>
            </form>

            @if (seciliMakaleId.HasValue)
            {
                <div class="alert alert-info">
                    <h3 class="mb-0"><i class="fas fa-file-alt"></i> Seçili Makale: @seciliMakaleId</h3>
                </div>

                <div class="chat-container mb-4" style="border: 1px solid #e0e0e0; border-radius: 8px; padding: 15px; height: 400px; overflow-y: auto; background-color: #f8f9fa;">
                    @foreach (var mesaj in Model)
                    {
                        <div class="message mb-3">
                            <div class="message-content p-3 rounded" style="background-color: #e9ecef;">
                                <div class="message-header">
                                    <strong class="text-primary">@mesaj.Gonderici.Eposta</strong>
                                </div>
                                <div class="message-body mt-2">
                                    @mesaj.Icerik
                                </div>
                            </div>
                        </div>
                    }
                </div>

                <form method="post" asp-action="MesajGonder" class="mt-4">
                    <input type="hidden" name="makaleId" value="@seciliMakaleId" />
                    <div class="form-group">
                        <textarea name="mesajIcerik" class="form-control" rows="3" placeholder="Mesajınızı yazın..." style="resize: none;"></textarea>
                    </div>
                    <button type="submit" class="btn btn-primary mt-2">
                        <i class="fas fa-paper-plane"></i> Gönder
                    </button>
                </form>

                @if (TempData["Hata"] != null)
                {
                    <div class="alert alert-danger mt-3">
                        <i class="fas fa-exclamation-circle"></i> @TempData["Hata"]
                    </div>
                }
            }
            else
            {
                <div class="alert alert-warning">
                    <i class="fas fa-info-circle"></i> Lütfen bir makale seçin.
                </div>
            }
        </div>
    </div>
</div>

<style>
    .chat-container::-webkit-scrollbar {
        width: 6px;
    }

    .chat-container::-webkit-scrollbar-track {
        background: #f1f1f1;
    }

    .chat-container::-webkit-scrollbar-thumb {
        background: #888;
        border-radius: 3px;
    }

        .chat-container::-webkit-scrollbar-thumb:hover {
            background: #555;
        }

    .message {
        max-width: 80%;
    }

    .message-content {
        box-shadow: 0 1px 2px rgba(0,0,0,0.1);
    }
</style>
