@model List<makalesistemi.Models.Sohbet>

@{
    ViewData["Title"] = "Sohbet Detayları";
}

<div class="container mt-4">
    <div class="card shadow">
        <div class="card-header bg-primary text-white d-flex justify-content-between align-items-center">
            <h2 class="mb-0"><i class="fas fa-comments"></i> Makale Sohbeti</h2>
            <a asp-controller="Admin" asp-action="Sohbet" class="btn btn-light">
                <i class="fas fa-arrow-left"></i> Geri Dön
            </a>
        </div>
        <div class="card-body">
            <div class="chat-container mb-4" style="max-height: 500px; overflow-y: auto; background-color: #f8f9fa; border-radius: 8px; padding: 15px;">
                @foreach (var mesaj in Model)
                {
                    bool gondericiAdminMi = mesaj.GondericiId == ViewBag.AdminID;
                    <div class="message mb-3 @(gondericiAdminMi ? "text-end" : "text-start")">
                        <div class="message-content p-3 rounded d-inline-block @(gondericiAdminMi ? "bg-primary text-white" : "bg-light")" style="max-width: 80%;">
                            <div class="message-header">
                                <strong>@(gondericiAdminMi ? "Admin" : "Kullanıcı")</strong>
                            </div>
                            <div class="message-body mt-2">
                                @mesaj.Icerik
                            </div>
                            <div class="message-footer mt-2">
                                <small class="@(gondericiAdminMi ? "text-white-50" : "text-muted")">
                                    <i class="far fa-clock"></i> @mesaj.Tarih.ToString("dd.MM.yyyy HH:mm")
                                </small>
                            </div>
                        </div>
                    </div>
                }
            </div>

            <form asp-controller="Admin" asp-action="SohbetGonder" method="post" class="mt-4">
                <input type="hidden" name="makaleId" value="@ViewBag.MakaleId" />
                <div class="input-group">
                    <input type="text" name="mesaj" class="form-control" placeholder="Mesajınızı yazın..." required>
                    <button type="submit" class="btn btn-primary">
                        <i class="fas fa-paper-plane"></i> Gönder
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<style>
    .chat-container::-webkit-scrollbar {
        width: 6px;
    }

    .chat-container::-webkit-scrollbar-track {
        background: #f1f1f1;
    }

    .chat-container::-webkit-scrollbar-thumb {
        background: #888;
        border-radius: 3px;
    }

        .chat-container::-webkit-scrollbar-thumb:hover {
            background: #555;
        }

    .message-content {
        box-shadow: 0 1px 2px rgba(0,0,0,0.1);
    }

        .message-content.bg-primary {
            background-color: #007bff !important;
        }

        .message-content.bg-light {
            background-color: #f8f9fa !important;
        }
</style>
