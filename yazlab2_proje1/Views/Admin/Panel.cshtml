@model Tuple<List<makalesistemi.Models.Makale>, List<makalesistemi.Models.Makale>, List<makalesistemi.Models.Makale>, List<makalesistemi.Models.Hakem>>

@{
    ViewData["Title"] = "Yönetici Paneli";
    var anonimMakaleListesi = Model.Item1; // Anonimleştirilmiş makaleler
    var anonimDegilMakaleListesi = Model.Item2; // Anonimleştirilmemiş makaleler
    var editoreIletilenMakaleListesi = Model.Item3; // Editöre iletilen makaleler
    var hakemListesi = Model.Item4; // Hakemler
}

<h2 class="text-center">📌 Yönetici Paneli</h2>

<div class="position-absolute top-0 end-0 p-3">
    <a asp-controller="Admin" asp-action="Sohbet" class="btn btn-info">💬 Sohbet</a>
</div>

<!-- 🔴 Anonimleştirilmemiş Makaleler -->
<h3 class="mt-4">🔴 Anonimleştirilmemiş Makaleler</h3>
<table class="table table-bordered">
    <thead class="table-dark">
        <tr>
            <th>ID</th>
            <th>Dosya Yolu</th>
            <th>İşlemler</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var makale in anonimDegilMakaleListesi)
        {
            <tr>
                <td>@makale.Id</td>
                <td><a href="@makale.DosyaYolu" target="_blank" class="btn btn-link">📄 PDF Görüntüle</a></td>
                <td>
                    <a asp-controller="Admin" asp-action="Goruntule" asp-route-id="@makale.Id" class="btn btn-primary">📄 Görüntüle</a>
                    <a asp-controller="Admin" asp-action="Anonimlestir" asp-route-id="@makale.Id" class="btn btn-warning">🔏 Anonimleştir</a>
                    <form asp-action="AnonimlestirmeTespit" method="post">
                        <input type="hidden" name="id" value="@makale.Id" />
                        <button type="submit" class="btn btn-info">Anonimleştirilecek Alanları Tespit Et</button>
                    </form>


                </td>
            </tr>
        }
    </tbody>
</table>

<!-- 🟢 Anonimleştirilmiş Makaleler -->
<h3 class="mt-4">🟢 Anonimleştirilmiş Makaleler</h3>
<table class="table table-bordered">
    <thead class="table-success">
        <tr>
            <th>ID</th>
            <th>Dosya Yolu</th>
            <th>İşlemler</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var makale in anonimMakaleListesi)
        {
            <tr>
                <td>@makale.Id</td>
                <td><a href="@makale.DosyaYolu" target="_blank" class="btn btn-link">📄 PDF Görüntüle</a></td>
                <td>
                    <a asp-controller="Admin" asp-action="Goruntule" asp-route-id="@makale.Id" class="btn btn-primary">📄 Görüntüle</a>

                    <!-- Makalenin Konusu Butonu -->
                    <form asp-controller="Admin" asp-action="MakaleKonusunuBul" method="post" class="d-inline">
                        <input type="hidden" name="makaleId" value="@makale.Id" />
                        <button type="submit" class="btn btn-info">📌 Makalenin Konusu</button>
                    </form>
                 

                    <!-- 🔽 Hakem Seçme Formu -->
                    <form asp-controller="Admin" asp-action="HakemeYolla" method="post" class="d-inline">
                        <input type="hidden" name="makaleId" value="@makale.Id" />

                        <select name="hakemId" class="form-select d-inline w-auto">
                            @foreach (var hakem in hakemListesi)
                            {
                                <option value="@hakem.Id">@hakem.Isim</option>
                            }
                        </select>

                        <button type="submit" class="btn btn-success">📤 Hakeme Yönlendir</button>
                    </form>
                </td>
            </tr>
        }
    </tbody>
</table>

<!-- 🟡 Editöre İletilen Makaleler -->
<h3 class="mt-4">🟡 Editöre İletilen Makaleler</h3>
<table class="table table-bordered">
    <thead class="table-warning">
        <tr>
            <th>ID</th>
            <th>Dosya Yolu</th>
            <th>İşlemler</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var makale in editoreIletilenMakaleListesi)
        {
            <tr>
                <td>@makale.Id</td>
                <td><a href="@makale.DegerlendirmeDosyaYolu" target="_blank" class="btn btn-link">📄 PDF Görüntüle</a></td>
                <td>
                    <a asp-controller="Admin" asp-action="Goruntule" asp-route-id="@makale.Id" class="btn btn-primary">📄 Görüntüle</a>

                    <!-- Yazara İlet Butonu -->
                    <form asp-controller="Admin" asp-action="YazaraIlet" method="post" class="d-inline">
                        <input type="hidden" name="makaleId" value="@makale.Id" />
                        <button type="submit" class="btn btn-danger">📩 Yazara İlet</button>
                    </form>
                </td>
            </tr>
        }
    </tbody>
</table>

<!-- Konu Bilgisi Modal -->
<div class="modal fade" id="konuModal" tabindex="-1" aria-labelledby="konuModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="konuModalLabel">Makale Konusu Bilgisi</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body" id="konuModalBody">
                <!-- Mesaj buraya gelecek -->
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Kapat</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        $(document).ready(function() {
            // Makale konusu butonuna tıklanınca
            $('form[action*="MakaleKonusunuBul"]').submit(function(e) {
                e.preventDefault(); // Formun normal submitini engelle

                var form = $(this);
                var makaleId = form.find('input[name="makaleId"]').val();

                $.ajax({
                    url: form.attr('action'),
                    type: 'POST',
                    data: form.serialize(),
                    success: function(response) {
                        if (response.success) {
                            // Modal içeriğini güncelle ve göster
                            $('#konuModalBody').html(response.message);
                            $('#konuModal').modal('show');
                        } else {
                            $('#konuModalBody').html('<div class="alert alert-danger">' + response.message + '</div>');
                            $('#konuModal').modal('show');
                        }
                    },
                    error: function(xhr) {
                        $('#konuModalBody').html('<div class="alert alert-danger">İşlem sırasında bir hata oluştu.</div>');
                        $('#konuModal').modal('show');
                    }
                });
            });
        });
    </script>
}