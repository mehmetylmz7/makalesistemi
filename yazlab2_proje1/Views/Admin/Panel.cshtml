@model Tuple<List<makalesistemi.Models.Makale>, List<makalesistemi.Models.Makale>, List<makalesistemi.Models.Makale>, List<makalesistemi.Models.Hakem>>

@{
    ViewData["Title"] = "Yönetici Paneli";
    var anonimMakaleListesi = Model.Item1;
    var anonimDegilMakaleListesi = Model.Item2;
    var editoreIletilenMakaleListesi = Model.Item3;
    var hakemListesi = Model.Item4;
}

<div class="container-fluid py-4">
    <div class="row mb-4">
        <div class="col-12">
            <div class="card shadow-sm">
                <div class="card-header bg-primary text-white d-flex justify-content-between align-items-center">
                    <h2 class="mb-0"><i class="fas fa-cogs me-2"></i>Yönetici Paneli</h2>
                    <a asp-controller="Admin" asp-action="Sohbet" class="btn btn-light">
                        <i class="fas fa-comments me-1"></i> Sohbet
                    </a>
                </div>
            </div>
        </div>
    </div>

    <!-- 🔴 Anonimleştirilmemiş Makaleler -->
    <div class="row mb-4">
        <div class="col-12">
            <div class="card shadow-sm">
                <div class="card-header bg-danger text-white">
                    <h3 class="mb-0"><i class="fas fa-exclamation-circle me-2"></i>Anonimleştirilmemiş Makaleler</h3>
                </div>
                <div class="card-body">
                    <div class="table-responsive">
                        <table class="table table-hover">
                            <thead>
                                <tr>
                                    <th>ID</th>
                                    <th>Dosya Yolu</th>
                                    <th>İşlemler</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var makale in anonimDegilMakaleListesi)
                                {
                                    <tr>
                                        <td>@makale.Id</td>
                                        <td>
                                            <a href="@makale.DosyaYolu" target="_blank" class="btn btn-outline-primary btn-sm">
                                                <i class="fas fa-file-pdf me-1"></i> PDF Görüntüle
                                            </a>
                                        </td>
                                        <td>
                                            <div class="btn-group">
                                                <a asp-controller="Admin" asp-action="Goruntule" asp-route-id="@makale.Id" class="btn btn-primary btn-sm">
                                                    <i class="fas fa-eye me-1"></i> Görüntüle
                                                </a>
                                                <a asp-controller="Admin" asp-action="Anonimlestir" asp-route-id="@makale.Id" class="btn btn-warning btn-sm">
                                                    <i class="fas fa-lock me-1"></i> Anonimleştir
                                                </a>
                                                <form asp-action="AnonimlestirmeTespit" method="post" class="d-inline">
                                                    <input type="hidden" name="id" value="@makale.Id" />
                                                    <button type="submit" class="btn btn-info btn-sm">
                                                        <i class="fas fa-search me-1"></i> Alanları Tespit Et
                                                    </button>
                                                </form>
                                            </div>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- 🟢 Anonimleştirilmiş Makaleler -->
    <div class="row mb-4">
        <div class="col-12">
            <div class="card shadow-sm">
                <div class="card-header bg-success text-white">
                    <h3 class="mb-0"><i class="fas fa-check-circle me-2"></i>Anonimleştirilmiş Makaleler</h3>
                </div>
                <div class="card-body">
                    <div class="table-responsive">
                        <table class="table table-hover">
                            <thead>
                                <tr>
                                    <th>ID</th>
                                    <th>Dosya Yolu</th>
                                    <th>İşlemler</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var makale in anonimMakaleListesi)
                                {
                                    <tr>
                                        <td>@makale.Id</td>
                                        <td>
                                            <a href="@makale.DosyaYolu" target="_blank" class="btn btn-outline-primary btn-sm">
                                                <i class="fas fa-file-pdf me-1"></i> PDF Görüntüle
                                            </a>
                                        </td>
                                        <td>
                                            <div class="btn-group">
                                                <a asp-controller="Admin" asp-action="Goruntule" asp-route-id="@makale.Id" class="btn btn-primary btn-sm">
                                                    <i class="fas fa-eye me-1"></i> Görüntüle
                                                </a>
                                                <form asp-controller="Admin" asp-action="MakaleKonusunuBul" method="post" class="d-inline">
                                                    <input type="hidden" name="makaleId" value="@makale.Id" />
                                                    <button type="submit" class="btn btn-info btn-sm">
                                                        <i class="fas fa-tag me-1"></i> Makalenin Konusu
                                                    </button>
                                                </form>
                                                <form asp-controller="Admin" asp-action="HakemeYolla" method="post" class="d-inline">
                                                    <input type="hidden" name="makaleId" value="@makale.Id" />
                                                    <select name="hakemId" class="form-select form-select-sm d-inline-block w-auto">
                                                        @foreach (var hakem in hakemListesi)
                                                        {
                                                            <option value="@hakem.Id">@hakem.Isim</option>
                                                        }
                                                    </select>
                                                    <button type="submit" class="btn btn-success btn-sm">
                                                        <i class="fas fa-paper-plane me-1"></i> Hakeme Yönlendir
                                                    </button>
                                                </form>
                                            </div>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- 🟡 Editöre İletilen Makaleler -->
    <div class="row mb-4">
        <div class="col-12">
            <div class="card shadow-sm">
                <div class="card-header bg-warning text-dark">
                    <h3 class="mb-0"><i class="fas fa-envelope me-2"></i>Editöre İletilen Makaleler</h3>
                </div>
                <div class="card-body">
                    <div class="table-responsive">
                        <table class="table table-hover">
                            <thead>
                                <tr>
                                    <th>ID</th>
                                    <th>Dosya Yolu</th>
                                    <th>İşlemler</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var makale in editoreIletilenMakaleListesi)
                                {
                                    <tr>
                                        <td>@makale.Id</td>
                                        <td>
                                            <a href="@makale.DegerlendirmeDosyaYolu" target="_blank" class="btn btn-outline-primary btn-sm">
                                                <i class="fas fa-file-pdf me-1"></i> PDF Görüntüle
                                            </a>
                                        </td>
                                        <td>
                                            <div class="btn-group">
                                                <a asp-controller="Admin" asp-action="Goruntule" asp-route-id="@makale.Id" class="btn btn-primary btn-sm">
                                                    <i class="fas fa-eye me-1"></i> Görüntüle
                                                </a>
                                                <form asp-controller="Admin" asp-action="YazaraIlet" method="post" class="d-inline">
                                                    <input type="hidden" name="makaleId" value="@makale.Id" />
                                                    <button type="submit" class="btn btn-danger btn-sm">
                                                        <i class="fas fa-envelope me-1"></i> Yazara İlet
                                                    </button>
                                                </form>
                                            </div>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Konu Bilgisi Modal -->
<div class="modal fade" id="konuModal" tabindex="-1" aria-labelledby="konuModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header bg-primary text-white">
                <h5 class="modal-title" id="konuModalLabel">
                    <i class="fas fa-info-circle me-2"></i>Makale Konusu Bilgisi
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body" id="konuModalBody">
                <!-- Mesaj buraya gelecek -->
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
                    <i class="fas fa-times me-1"></i> Kapat
                </button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        $(document).ready(function() {
            $('form[action*="MakaleKonusunuBul"]').submit(function(e) {
                e.preventDefault();
                var form = $(this);
                var makaleId = form.find('input[name="makaleId"]').val();

                $.ajax({
                    url: form.attr('action'),
                    type: 'POST',
                    data: form.serialize(),
                    success: function(response) {
                        if (response.success) {
                            $('#konuModalBody').html(response.message);
                            $('#konuModal').modal('show');
                        } else {
                            $('#konuModalBody').html('<div class="alert alert-danger">' + response.message + '</div>');
                            $('#konuModal').modal('show');
                        }
                    },
                    error: function(xhr) {
                        $('#konuModalBody').html('<div class="alert alert-danger">İşlem sırasında bir hata oluştu.</div>');
                        $('#konuModal').modal('show');
                    }
                });
            });
        });
    </script>
}