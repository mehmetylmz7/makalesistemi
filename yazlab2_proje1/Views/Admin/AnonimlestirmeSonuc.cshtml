@model List<string>

@{
    ViewData["Title"] = "Anonimleştirme Sonuçları";
}

<div class="container mt-4">
    <div class="card shadow">
        <div class="card-header bg-primary text-white">
            <h3><i class="fas fa-user-shield me-2"></i>Anonimleştirme Sonuçları</h3>
        </div>

        <div class="card-body">
            @if (Model != null && Model.Any())
            {
                <div class="alert alert-info">
                    <i class="fas fa-info-circle me-2"></i>
                    <strong>@Model.Count adet</strong> hassas veri tespit edildi.
                </div>

                <form id="anonimForm" asp-action="Anonimlestir2" method="post">
                    <input type="hidden" name="id" value="@ViewData["MakaleId"]" />

                    <div class="table-responsive">
                        <table class="table table-hover">
                            <thead>
                                <tr>
                                    <th style="width:40px;">Seç</th>
                                    <th>Tespit Edilen İçerik</th>
                                    <th>Tip</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in Model)
                                {
                                    <tr>
                                        <td>
                                            <input type="checkbox" name="secilenAlanlar" value="@item" checked class="alan-checkbox" />
                                        </td>
                                        <td>@item</td>
                                        <td>
                                            @if (item.Contains("@"))
                                            {
                                                <span class="badge bg-danger">E-posta</span>
                                            }
                                            else if (item.Split(' ').Length > 1)
                                            {
                                                <span class="badge bg-warning">Ad Soyad</span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-info">Diğer</span>
                                            }
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>

                    <div class="mt-3">
                        <button type="submit" class="btn btn-warning">
                            <i class="fas fa-mask me-1"></i>Seçilenleri Anonimleştir
                        </button>
                    </div>
                </form>
            }
            else
            {
                <div class="alert alert-success">
                    <i class="fas fa-check-circle me-2"></i>
                    Hassas veri tespit edilmedi.
                </div>
            }
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script>
        document.getElementById('anonimForm').addEventListener('submit', function(e) {
            e.preventDefault();

            const selectedItems = Array.from(document.querySelectorAll('.alan-checkbox:checked')).map(el => el.value);
            const makaleId = document.querySelector('input[name="id"]').value;

            if (selectedItems.length === 0) {
                Swal.fire({
                    icon: 'warning',
                    title: 'Uyarı',
                    text: 'Lütfen en az bir alan seçiniz',
                    confirmButtonText: 'Tamam'
                });
                return;
            }

            Swal.fire({
                title: 'Emin misiniz?',
                text: `${selectedItems.length} adet alan anonimleştirilecek`,
                icon: 'question',
                showCancelButton: true,
                confirmButtonColor: '#3085d6',
                cancelButtonColor: '#d33',
                confirmButtonText: 'Evet, devam et',
                cancelButtonText: 'İptal'
            }).then((result) => {
                if (result.isConfirmed) {
                    // Form verilerini topla ve AJAX ile gönder
                    const formData = new FormData();
                    formData.append('id', makaleId);
                    selectedItems.forEach(item => formData.append('secilenAlanlar', item));

                    fetch('@Url.Action("Anonimlestir2", "Admin")', {
                        method: 'POST',
                        body: formData,
                        headers: {
                            'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]').value
                        }
                    })
                    .then(response => {
                        if (response.redirected) {
                            window.location.href = response.url;
                        } else {
                            return response.json();
                        }
                    })
                    .then(data => {
                        if (data && data.success) {
                            Swal.fire('Başarılı!', data.message, 'success')
                                .then(() => window.location.href = '@Url.Action("Panel", "Admin")');
                        } else {
                            Swal.fire('Hata!', data?.message || 'Bir hata oluştu', 'error');
                        }
                    })
                    .catch(error => {
                        Swal.fire('Hata!', 'İşlem sırasında bir hata oluştu: ' + error, 'error');
                    });
                }
            });
        });
    </script>
}