@model List<makalesistemi.Models.Makale>

@{
    ViewData["Title"] = "Hakem Paneli";
    var hakemId = ViewBag.HakemId;
}

<h2 class="text-center">📜 Hakem Paneli</h2>

@if (ViewData["Message"] != null)
{
    <div class="alert alert-info text-center">
        @ViewData["Message"]
    </div>
}

@if (Model == null || Model.Count == 0)
{
    <div class="alert alert-warning text-center">
        📌 Şu anda size atanmış bir makale bulunmamaktadır.
    </div>
}
else
{
    <h3 class="mt-4">📄 Size Atanan Makaleler</h3>
    <table class="table table-bordered">
        <thead class="table-primary">
            <tr>
                <th>ID</th>
                <th>Dosya</th>
                <th>İşlemler</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var makale in Model)
            {
                var degerlendirme = makale.Degerlendirmeler?.FirstOrDefault(d => d.HakemId == hakemId);

                <tr>
                    <td>@makale.Id</td>
                    <td>
                        <a href="@makale.DosyaYolu" target="_blank" class="btn btn-link">📄 PDF Görüntüle</a>
                    </td>
                    <td>
                        @if (degerlendirme != null)
                        {
                            <div class="alert alert-success text-center">
                                📌 Değerlendirme Yapıldı
                            </div>

                            <button class="btn btn-warning" data-bs-toggle="modal" data-bs-target="#guncelleModal_@makale.Id">
                                📝 Güncelle
                            </button>

                            <form asp-controller="Hakem" asp-action="DegerlendirmeSil" method="post" class="d-inline">
                                <input type="hidden" name="degerlendirmeId" value="@degerlendirme.Id" />
                                <button type="submit" class="btn btn-danger">🗑️ Sil</button>
                            </form>

                            <!-- Güncelleme Modal -->
                            <div class="modal fade" id="guncelleModal_@makale.Id" tabindex="-1" aria-labelledby="modalLabel_@makale.Id" aria-hidden="true">
                                <div class="modal-dialog">
                                    <div class="modal-content">
                                        <div class="modal-header">
                                            <h5 class="modal-title">📜 Değerlendirmeyi Güncelle</h5>
                                            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Kapat"></button>
                                        </div>
                                        <div class="modal-body">
                                            <form asp-controller="Hakem" asp-action="DegerlendirmeGuncelle" method="post">
                                                <input type="hidden" name="degerlendirmeId" value="@degerlendirme.Id" />

                                                <div class="mb-3">
                                                    <label class="form-label">Yeni Değerlendirme:</label>
                                                    <textarea name="guncelDegerlendirme" class="form-control" rows="4" required>@degerlendirme.HakemDegerlendirmesi</textarea>
                                                </div>

                                                <div class="modal-footer">
                                                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">İptal</button>
                                                    <button type="submit" class="btn btn-success">📤 Güncelle</button>
                                                </div>
                                            </form>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        }
                        else
                        {
                            <button class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#degerlendirmeModal_@makale.Id">
                                ✍️ Değerlendir
                            </button>

                            <!-- Yeni Değerlendirme Modal -->
                            <div class="modal fade" id="degerlendirmeModal_@makale.Id" tabindex="-1" aria-labelledby="modalLabel_@makale.Id" aria-hidden="true">
                                <div class="modal-dialog">
                                    <div class="modal-content">
                                        <div class="modal-header">
                                            <h5 class="modal-title">📜 Makale Değerlendirme</h5>
                                            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Kapat"></button>
                                        </div>
                                        <div class="modal-body">
                                            <form asp-controller="Hakem" asp-action="Degerlendir" method="post">
                                                <input type="hidden" name="makaleId" value="@makale.Id" />

                                                <div class="mb-3">
                                                    <label class="form-label">Hakem Değerlendirmesi:</label>
                                                    <textarea name="degerlendirme" class="form-control" rows="4" required></textarea>
                                                </div>

                                                <div class="modal-footer">
                                                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">İptal</button>
                                                    <button type="submit" class="btn btn-success">📤 Kaydet</button>
                                                </div>
                                            </form>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
}

<!-- Çıkış Yap Butonu -->
<div class="text-center mt-4">
    <a asp-controller="Hakem" asp-action="Cikis" class="btn btn-danger">🚪 Çıkış Yap</a>
</div>
