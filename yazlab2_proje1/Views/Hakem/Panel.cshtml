@model List<makalesistemi.Models.Makale>

@{
    ViewData["Title"] = "Hakem Paneli";
}

<h2 class="text-center">📜 Hakem Paneli</h2>

@if (ViewData["Message"] != null)
{
    <div class="alert alert-info text-center">
        @ViewData["Message"]
    </div>
}

@if (Model.Count == 0)
{
    <div class="alert alert-warning text-center">
        📌 Şu anda size atanmış bir makale bulunmamaktadır.
    </div>
}
else
{
    <h3 class="mt-4">📄 Size Atanan Makaleler</h3>
    <table class="table table-bordered">
        <thead class="table-primary">
            <tr>
                <th>ID</th>
                <th>Dosya Yolu</th>
                <th>İşlemler</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var makale in Model)
            {
                <tr>
                    <td>@makale.Id</td>
                    <td><a href="@makale.DosyaYolu" target="_blank" class="btn btn-link">📄 PDF Görüntüle</a></td>
                    <td>
                        <a asp-controller="Hakem" asp-action="Goruntule" asp-route-id="@makale.Id" class="btn btn-primary">📂 Makaleyi Aç</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}

<!-- Çıkış Yap Butonu -->
<div class="text-center mt-4">
    <a asp-controller="Hakem" asp-action="Cikis" class="btn btn-danger">🚪 Çıkış Yap</a>
</div>
